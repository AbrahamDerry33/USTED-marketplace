# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Comma-separated list of allowed school email domains (e.g. st.ug.edu.gh,ug.edu.gh).
# Leave empty until the school confirms the official domain(s).
VITE_SCHOOL_EMAIL_DOMAINS=""

# Optional: Firebase App Check reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=""

# Set to "true" when running locally against Firebase Emulators
VITE_USE_EMULATORS="false"
