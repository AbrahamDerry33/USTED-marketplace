# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated list of extra academic email domains for awarding the
# non-blocking "Verified Student" badge (`.edu` and `.edu.gh` are built-in).
# Non-academic email addresses (Gmail, Yahoo, Outlook, etc.) are always allowed.
VITE_SCHOOL_EMAIL_DOMAINS=""

# Optional: Firebase App Check reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=""

# Set to "true" when running locally against Firebase Emulators
VITE_USE_EMULATORS="false"

# Google Maps JavaScript API key for Campus Meetup Map
VITE_GOOGLE_MAPS_API_KEY=""

# Cloud SQL PostgreSQL runtime and Drizzle Kit admin credentials (Object Method)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
